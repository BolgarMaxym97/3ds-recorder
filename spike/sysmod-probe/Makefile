# recprobe sysmodule (phase S spike) -> recprobe.cxi (copy to /luma/sysmodules/0004013000F1D302.cxi)
.SUFFIXES:
ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment")
endif
include $(DEVKITARM)/3ds_rules

TARGET   := recprobe
BUILD    := build
SOURCES  := source ../../codec/source
INCLUDES := source ../common ../../codec/include

ARCH     := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft
CFLAGS   := -g -Wall -Wextra -O2 -mword-relocations -ffunction-sections -fno-strict-aliasing $(ARCH) -std=gnu11
CFLAGS   += $(INCLUDE) -D__3DS__
ASFLAGS  := -g $(ARCH)
LDFLAGS   = -specs=3dsx.specs -g $(ARCH) -Wl,-Map,$(notdir $*.map)
LIBS     := -lctru -lm
LIBDIRS  := $(CTRULIB)

ifneq ($(BUILD),$(notdir $(CURDIR)))
export OUTPUT  := $(CURDIR)/$(TARGET)
export TOPDIR  := $(CURDIR)
export VPATH   := $(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
export DEPSDIR := $(CURDIR)/$(BUILD)
CFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
SFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
export LD := $(CC)
export OFILES := $(CFILES:.c=.o) $(SFILES:.s=.o)
export INCLUDE := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) $(foreach dir,$(LIBDIRS),-I$(dir)/include) -I$(CURDIR)/$(BUILD)
export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

.PHONY: all clean
all: $(BUILD)
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile
	@makerom -f ncch -rsf $(TOPDIR)/$(TARGET).rsf -o $(OUTPUT).cxi -elf $(OUTPUT).elf
	@printf '/* generated by spike/sysmod-probe/Makefile */\n#define RECPROBE_DIAG_VA 0x%s\n' \
	    $$($(DEVKITARM)/bin/arm-none-eabi-nm $(OUTPUT).elf | awk '$$3 == "g_diag" { print $$1 }') \
	    > $(TOPDIR)/../launcher/source/diag_addr.h
	@echo built ... $(TARGET).cxi

$(BUILD):
	@mkdir -p $@

clean:
	@rm -fr $(BUILD) $(TARGET).elf $(TARGET).cxi
else
DEPENDS := $(OFILES:.o=.d)
$(OUTPUT).elf: $(OFILES)
-include $(DEPENDS)
endif
